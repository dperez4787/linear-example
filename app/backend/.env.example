# Copy to .env and fill in. .env is gitignored and must never be committed.
# Get MONGODB_URI from Atlas: Connect > Drivers > Node.js, then substitute the
# database user's password for the <db_password> placeholder. If the password
# contains @ / : or #, percent-encode it.
MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/?appName=Cluster0

# The app's database. Tests must use linear_example_test instead.
MONGODB_DB=linear_example

PORT=8080

# AI gateway (DAN-48). Every model call flows through this gateway; the backend
# never holds a provider (OpenAI/Anthropic/...) API key — only the gateway's own
# bearer key. Both are read lazily: the server boots and serves /health without
# them, and AI features fail cleanly until they are set.
AI_GATEWAY_URL=https://<gateway-host>
AI_GATEWAY_KEY=<gateway-bearer-key>
